# GENERATED by chtc/make_bo_dag.py -- regenerate rather than edit.
#   python3 chtc/make_bo_dag.py --rounds 5 --batch 5 --covariates scene_prior --epochs 20 --final-multiplier 2 --run bo25rep --tag borep --split replicate_split_v1
#
# Propose round 3 of a study's Bayesian optimization. CPU only, under a minute.
#
# Reads the 15 record(s) the earlier rounds left on /staging and writes the next
# 5 parameter files. Round 0 reads nothing and proposes the published configuration
# as its trial 0, so every study contains its own baseline.

include : ../site.conf

universe             = container
container_image      = $(SIF)
container_target_dir = /workspace/project

executable = ../bo_round.sh
arguments  = $(study) 3 5

transfer_input_files = ../job_common.sh, \
                       ../oco2_code.tar.gz, \
                       $(OSDF)/results/bo25rep/bo_$(study)_r0_t0.json, \
                       $(OSDF)/results/bo25rep/bo_$(study)_r0_t1.json, \
                       $(OSDF)/results/bo25rep/bo_$(study)_r0_t2.json, \
                       $(OSDF)/results/bo25rep/bo_$(study)_r0_t3.json, \
                       $(OSDF)/results/bo25rep/bo_$(study)_r0_t4.json, \
                       $(OSDF)/results/bo25rep/bo_$(study)_r1_t0.json, \
                       $(OSDF)/results/bo25rep/bo_$(study)_r1_t1.json, \
                       $(OSDF)/results/bo25rep/bo_$(study)_r1_t2.json, \
                       $(OSDF)/results/bo25rep/bo_$(study)_r1_t3.json, \
                       $(OSDF)/results/bo25rep/bo_$(study)_r1_t4.json, \
                       $(OSDF)/results/bo25rep/bo_$(study)_r2_t0.json, \
                       $(OSDF)/results/bo25rep/bo_$(study)_r2_t1.json, \
                       $(OSDF)/results/bo25rep/bo_$(study)_r2_t2.json, \
                       $(OSDF)/results/bo25rep/bo_$(study)_r2_t3.json, \
                       $(OSDF)/results/bo25rep/bo_$(study)_r2_t4.json

should_transfer_files   = YES
when_to_transfer_output = ON_EXIT
transfer_output_files   = bo_$(study)_r3_t0.params.json, \
                          bo_$(study)_r3_t1.params.json, \
                          bo_$(study)_r3_t2.params.json, \
                          bo_$(study)_r3_t3.params.json, \
                          bo_$(study)_r3_t4.params.json
transfer_output_remaps  = "bo_$(study)_r3_t0.params.json = $(OSDF)/results/bo25rep/bo_$(study)_r3_t0.params.json ; \
                           bo_$(study)_r3_t1.params.json = $(OSDF)/results/bo25rep/bo_$(study)_r3_t1.params.json ; \
                           bo_$(study)_r3_t2.params.json = $(OSDF)/results/bo25rep/bo_$(study)_r3_t2.params.json ; \
                           bo_$(study)_r3_t3.params.json = $(OSDF)/results/bo25rep/bo_$(study)_r3_t3.params.json ; \
                           bo_$(study)_r3_t4.params.json = $(OSDF)/results/bo25rep/bo_$(study)_r3_t4.params.json"

requirements = $(STAGING_REQ)

request_cpus   = 1
request_memory = 4GB

# 20 GB for a job that reads a handful of 800-byte JSON files and writes five more.
#
# It is not the propose step that needs it: oco2_setup untars the whole code tarball, and
# that tarball grows every time fetch_results.sh unpacks results back into the checkout.
# At 4 GB a round-1 node was held with "disk usage exceeded request_disk". The real fix is
# keeping the tarball small (make_code_tarball.sh warns above 50 MB and names the biggest
# members), but a one-minute CPU job is the wrong place to be tight: the request is free,
# and a held propose node stalls a whole study.
request_disk   = 20GB

stream_output = true
stream_error  = true

log    = ../logs/bo_$(study)_propose_r3.log
output = ../logs/bo_$(study)_propose_r3.out
error  = ../logs/bo_$(study)_propose_r3.err

max_retries = 0
queue
