JOB det_xco2_propose_r3 propose_r3.sub
VARS det_xco2_propose_r3 study="det_xco2"
JOB det_xco2_trials_r3  trial.sub
VARS det_xco2_trials_r3 study="det_xco2" rnd="3"
PARENT det_xco2_propose_r3 CHILD det_xco2_trials_r3
PARENT det_xco2_trials_r2 CHILD det_xco2_propose_r3
JOB det_xco2_propose_r4 propose_r4.sub
VARS det_xco2_propose_r4 study="det_xco2"
JOB det_xco2_trials_r4  trial.sub
VARS det_xco2_trials_r4 study="det_xco2" rnd="4"
