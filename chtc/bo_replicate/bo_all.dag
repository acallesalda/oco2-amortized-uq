# GENERATED by chtc/make_bo_dag.py -- regenerate rather than edit.
#   python3 chtc/make_bo_dag.py --rounds 5 --batch 5 --covariates scene_prior --epochs 20 --final-multiplier 2 --run bo25rep --tag borep --split replicate_split_v1
#
#     mkdir -p chtc/logs && cd chtc/bo && condor_submit_dag bo_all.dag
#
# 6 studies x 5 rounds x 5 trials = 150 search trials, then 6 retrains at 40 epochs,
# then 4 scoring jobs on the test partition.
#
# Covariate set: scene_prior, fixed for every study. Trial epochs: 20. Final epochs: 40.
#
# Prerequisites, all in /staging (./fetch_results.sh --status will say):
#   oco2_processed_{train,test}.tar.gz, oco2_profile_stats.tar.gz  stage_data.sh
#   oco2_split_v1.tar.gz                                           prep.sub
#   oco2_covariates_v1.tar.gz                                      covariates.sub
#
# This run's trial records go to results/bo25rep/ rather than results/bo/, so nothing
# here can collide with an earlier search. OSDF refuses to overwrite an object:
# a collision is a held job, not a warning. Make the directory before submitting --
# if it is absent the first five uploads are held and the graph stalls at round 0:
#
#   NETID=$(whoami); mkdir -p "/staging/${NETID:0:1}/${NETID}/oco2/results/bo25rep"

# --------------------------------------------------------------------------
# det_xco2
JOB det_xco2_propose_r0 propose_r0.sub
VARS det_xco2_propose_r0 study="det_xco2"
JOB det_xco2_trials_r0  trial.sub
VARS det_xco2_trials_r0 study="det_xco2" rnd="0"
PARENT det_xco2_propose_r0 CHILD det_xco2_trials_r0
JOB det_xco2_propose_r1 propose_r1.sub
