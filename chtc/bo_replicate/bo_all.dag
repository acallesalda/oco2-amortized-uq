# --------------------------------------------------------------------------
# The test partition. Each job needs both models of its task, which is why
# these are the only nodes with two parents.
JOB eval_xco2 eval.sub
VARS eval_xco2 task="xco2" det_study="det_xco2" flow_study="nf_xco2"
PARENT det_xco2_final nf_xco2_final CHILD eval_xco2
JOB eval_profiles eval.sub
VARS eval_profiles task="profiles" det_study="det_profiles" flow_study="nf_profiles"
PARENT det_profiles_final nf_profiles_final CHILD eval_profiles
JOB eval_last4 eval.sub
VARS eval_last4 task="last4" det_study="det_last4" flow_study="nf_last4"
PARENT det_last4_final nf_last4_final CHILD eval_last4
JOB eval_last4_marginal eval.sub
VARS eval_last4_marginal task="last4_marginal" det_study="det_profiles" flow_study="nf_profiles"
PARENT det_profiles_final nf_profiles_final CHILD eval_last4_marginal

# --------------------------------------------------------------------------
# Throttles. DAGMan counts a node, not a proc: one trial wave is ONE job here and
# 5 GPUs on the pool, so --max-waves 3 is up to 15 concurrent trial jobs. The
# retrains and the scoring jobs are one GPU each and are counted separately;
# they only start once a study's five waves are finished, so the two limits do
# not stack in practice.
MAXJOBS WAVE 3
MAXJOBS SOLO 6

CATEGORY det_xco2_trials_r0 WAVE
CATEGORY det_xco2_trials_r1 WAVE
CATEGORY det_xco2_trials_r2 WAVE
CATEGORY det_xco2_trials_r3 WAVE
CATEGORY det_xco2_trials_r4 WAVE
CATEGORY det_profiles_trials_r0 WAVE
CATEGORY det_profiles_trials_r1 WAVE
CATEGORY det_profiles_trials_r2 WAVE
CATEGORY det_profiles_trials_r3 WAVE
CATEGORY det_profiles_trials_r4 WAVE
CATEGORY det_last4_trials_r0 WAVE
CATEGORY det_last4_trials_r1 WAVE
CATEGORY det_last4_trials_r2 WAVE
CATEGORY det_last4_trials_r3 WAVE
CATEGORY det_last4_trials_r4 WAVE
CATEGORY nf_xco2_trials_r0 WAVE
CATEGORY nf_xco2_trials_r1 WAVE
CATEGORY nf_xco2_trials_r2 WAVE
CATEGORY nf_xco2_trials_r3 WAVE
CATEGORY nf_xco2_trials_r4 WAVE
CATEGORY nf_profiles_trials_r0 WAVE
CATEGORY nf_profiles_trials_r1 WAVE
CATEGORY nf_profiles_trials_r2 WAVE
CATEGORY nf_profiles_trials_r3 WAVE
CATEGORY nf_profiles_trials_r4 WAVE
CATEGORY nf_last4_trials_r0 WAVE
CATEGORY nf_last4_trials_r1 WAVE
CATEGORY nf_last4_trials_r2 WAVE
CATEGORY nf_last4_trials_r3 WAVE
CATEGORY nf_last4_trials_r4 WAVE
CATEGORY det_xco2_final SOLO
CATEGORY det_profiles_final SOLO
CATEGORY det_last4_final SOLO
CATEGORY nf_xco2_final SOLO
CATEGORY nf_profiles_final SOLO
CATEGORY nf_last4_final SOLO
CATEGORY eval_xco2 SOLO
CATEGORY eval_profiles SOLO
CATEGORY eval_last4 SOLO
CATEGORY eval_last4_marginal SOLO

# One line per node, rewritten every 30 seconds:  watch cat chtc/bo/bo_all.status
NODE_STATUS_FILE bo_all.status 30
