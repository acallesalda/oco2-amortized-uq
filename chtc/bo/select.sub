# GENERATED by chtc/make_bo_dag.py -- regenerate rather than edit.
#   python3 chtc/make_bo_dag.py --rounds 5 --batch 5 --covariates scene_prior --epochs 20 --final-multiplier 2 --run bo25 --tag bo --split group_split_v1
#
# Pick study $(study)'s winner out of its 25 trial records. CPU only, under a minute.
#
# Every record is named explicitly: /staging cannot be globbed at submit time, but after
# 5 rounds of 5 the names are known in advance. A trial that failed still
# wrote a record and still exited 0, so all 25 are expected to be here; bo_select.py
# reports the failures and takes the minimum over the rest.

include : ../site.conf

universe             = container
container_image      = $(SIF)
container_target_dir = /workspace/project

executable = ../bo_select.sh
arguments  = $(study)

transfer_input_files = ../job_common.sh, \
                       ../oco2_code.tar.gz, \
                       $(OSDF)/results/bo25/bo_$(study)_r0_t0.json, \
                       $(OSDF)/results/bo25/bo_$(study)_r0_t1.json, \
                       $(OSDF)/results/bo25/bo_$(study)_r0_t2.json, \
                       $(OSDF)/results/bo25/bo_$(study)_r0_t3.json, \
                       $(OSDF)/results/bo25/bo_$(study)_r0_t4.json, \
                       $(OSDF)/results/bo25/bo_$(study)_r1_t0.json, \
                       $(OSDF)/results/bo25/bo_$(study)_r1_t1.json, \
                       $(OSDF)/results/bo25/bo_$(study)_r1_t2.json, \
                       $(OSDF)/results/bo25/bo_$(study)_r1_t3.json, \
                       $(OSDF)/results/bo25/bo_$(study)_r1_t4.json, \
                       $(OSDF)/results/bo25/bo_$(study)_r2_t0.json, \
                       $(OSDF)/results/bo25/bo_$(study)_r2_t1.json, \
                       $(OSDF)/results/bo25/bo_$(study)_r2_t2.json, \
                       $(OSDF)/results/bo25/bo_$(study)_r2_t3.json, \
                       $(OSDF)/results/bo25/bo_$(study)_r2_t4.json, \
                       $(OSDF)/results/bo25/bo_$(study)_r3_t0.json, \
                       $(OSDF)/results/bo25/bo_$(study)_r3_t1.json, \
                       $(OSDF)/results/bo25/bo_$(study)_r3_t2.json, \
                       $(OSDF)/results/bo25/bo_$(study)_r3_t3.json, \
                       $(OSDF)/results/bo25/bo_$(study)_r3_t4.json, \
                       $(OSDF)/results/bo25/bo_$(study)_r4_t0.json, \
                       $(OSDF)/results/bo25/bo_$(study)_r4_t1.json, \
                       $(OSDF)/results/bo25/bo_$(study)_r4_t2.json, \
                       $(OSDF)/results/bo25/bo_$(study)_r4_t3.json, \
                       $(OSDF)/results/bo25/bo_$(study)_r4_t4.json

should_transfer_files   = YES
when_to_transfer_output = ON_EXIT
transfer_output_files   = bo_$(study)_best.json, \
                          bo_$(study)_leaderboard.md
transfer_output_remaps  = "bo_$(study)_best.json = $(OSDF)/results/bo25/bo_$(study)_best.json ; \
                           bo_$(study)_leaderboard.md = $(OSDF)/results/bo25/bo_$(study)_leaderboard.md"

requirements = $(STAGING_REQ)

request_cpus   = 1
request_memory = 4GB
request_disk   = 20GB

stream_output = true
stream_error  = true

log    = ../logs/bo_$(study)_select.log
output = ../logs/bo_$(study)_select.out
error  = ../logs/bo_$(study)_select.err

max_retries = 0
queue
